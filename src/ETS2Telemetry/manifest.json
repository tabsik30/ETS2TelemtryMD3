{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.tabsik12.ets2-telemetry",
  "name": "ETS2/ATS Telemetry",
  "version": "1.0.0",
  "description": "Reads Euro Truck Simulator 2 / American Truck Simulator telemetry, exposes variables, and provides live speedometer and fuel gauge widgets.",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/ETS2Telemetry.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "Maciej Kaczmarek"
  },
  "license": "MIT",
  "repository": "https://github.com/tabsik30/ETS2TelemtryMD3",
  "compatibility": {
    "macroDeck": ">=3.0.0-beta.14"
  }
}
